# --- Control plane database (holds the tenant registry) ---
CONTROL_DB_HOST=localhost
CONTROL_DB_PORT=5432
CONTROL_DB_USER=hms_admin
CONTROL_DB_PASSWORD=changeme
CONTROL_DB_NAME=hms_control

# --- Tenant databases share this connection target; isolation is by schema ---
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432
TENANT_DB_USER=hms_admin
TENANT_DB_PASSWORD=changeme
TENANT_DB_NAME=hms_tenants

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- Patient portal auth (deliberately separate secret from staff JWT_SECRET) ---
PATIENT_JWT_SECRET=replace-with-a-different-long-random-secret

# --- Platform admin auth (deliberately separate secret again - this is
#     YOUR team's cross-tenant access, isolated from both staff and patient tokens) ---
PLATFORM_JWT_SECRET=replace-with-yet-another-long-random-secret

# --- AI (Communications module: public inquiries, patient chat, supplier drafts) ---
ANTHROPIC_API_KEY=

# --- M-Pesa (Safaricom Daraja API) ---
# Sandbox credentials come from https://developer.safaricom.co.ke - free
# to register. Production requires a registered paybill/shortcode with
# Safaricom business KYC (see SCOPE_Frontend_MPesa_SHA_Offline.md).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL Safaricom can call back to -
# use ngrok or similar for local development, since Safaricom cannot
# reach localhost.
MPESA_CALLBACK_BASE_URL=https://your-public-url.example.com

# --- App ---
PORT=3000
# Comma-separated. Leave unset for local dev (defaults to the three
# frontends' dev ports: 5173/5174/5175). Set explicitly in production.
CORS_ORIGINS=

# --- Phase 3: durable event delivery ---
# Dispatcher polls tenant outboxes; each tenant must license the target module.
EVENT_DISPATCH_INTERVAL_MS=5000
# Configure URLs only after the receiving service supports the HMS event envelope,
# HMAC verification, and idempotency-key handling. HTTPS is required in production.
PAYROLL_WEBHOOK_URL=
PAYROLL_WEBHOOK_SECRET=
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
